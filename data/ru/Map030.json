{"id":3,"name":"EV003","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":true,"image":{"tileId":0,"characterName":"ontan","direction":2,"pattern":1,"characterIndex":1},"list":[{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["kirrel50:"]},{"code":401,"indent":0,"parameters":["Привет, я kirrel. Или же venus, или же porfenal..."]},{"code":401,"indent":0,"parameters":["У меня много имён."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["kirrel50:"]},{"code":401,"indent":0,"parameters":["Я тот, кто решил серьёзно взяться за перевод "]},{"code":401,"indent":0,"parameters":["этой игры и, как вы можете видеть, он вышел."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["kirrel50:"]},{"code":401,"indent":0,"parameters":["Хочешь узнать об этом подробнее?"]},{"code":401,"indent":0,"parameters":["Ты не сможешь вернуться к этой строчке, если"]},{"code":401,"indent":0,"parameters":["откажешься."]},{"code":102,"indent":0,"parameters":[["Да","Нет"],1,0,2,0]},{"code":402,"indent":0,"parameters":[0,"Да"]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["kirrel50:"]},{"code":401,"indent":1,"parameters":["Что ж, тогда я начну.. Эм..."]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["kirrel50:"]},{"code":401,"indent":1,"parameters":["Впервые я узнал об этой игре полтора года назад,"]},{"code":401,"indent":1,"parameters":["летом 2023. Я увидел её на просторах англоязычного"]},{"code":401,"indent":1,"parameters":["интернета и подумал \"вау, это так круто!\"."]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["kirrel50:"]},{"code":401,"indent":1,"parameters":["И, хоть у меня не было доступа к ПК, мне захотелось"]},{"code":401,"indent":1,"parameters":["её пройти. "]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["kirrel50:"]},{"code":401,"indent":1,"parameters":["Первые мысли о переводе были уже тогда и, хоть"]},{"code":401,"indent":1,"parameters":["я и нашёл того, кто это сделает, ничего не вышло."]},{"code":401,"indent":1,"parameters":["Более того, я даже не прошёл саму игру."]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["kirrel50:"]},{"code":401,"indent":1,"parameters":["После этого прошла целая куча времени, я погрузился"]},{"code":401,"indent":1,"parameters":["в пучины депрессии и начал смотреть на мир иначе,"]},{"code":401,"indent":1,"parameters":["в итоге окончательно сломался."]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["kirrel50:"]},{"code":401,"indent":1,"parameters":["В октябре ещё текущего, 2024 года, я думал о том,"]},{"code":401,"indent":1,"parameters":["чтобы покончить с собой, но обстоятельства "]},{"code":401,"indent":1,"parameters":["сложились так, что это ужасное желание ушло."]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["kirrel50:"]},{"code":401,"indent":1,"parameters":["Можете не волноваться, сейчас со мной всё хорошо."]},{"code":401,"indent":1,"parameters":["Я нашёл место, где мне приятно находиться."]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["kirrel50:"]},{"code":401,"indent":1,"parameters":["Что же до перевода... Вторая попытка в перевод"]},{"code":401,"indent":1,"parameters":["свершилась в ноябре. В кратчайшие сроки нам удалось"]},{"code":401,"indent":1,"parameters":["полностью перевести игру и даже добавить в неё..."]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["kirrel50:"]},{"code":401,"indent":1,"parameters":["... немного нового контента!"]},{"code":401,"indent":1,"parameters":["К примеру - анонимного ненавистника гороха..."]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["kirrel50:"]},{"code":401,"indent":1,"parameters":["Не знаю, находили ли вы его сообщение, но на"]},{"code":401,"indent":1,"parameters":["локациях госпиталя, в женском туалете, оставлено"]},{"code":401,"indent":1,"parameters":["сообщение, написанное ненавистником гороха."]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["kirrel50:"]},{"code":401,"indent":1,"parameters":["Это я. А горох - вовсе не вкусное бобовое,"]},{"code":401,"indent":1,"parameters":["а человек, который похож на Рё и которого я "]},{"code":401,"indent":1,"parameters":["максимально не люблю. Зная его любовь к HfD..."]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["kirrel50: "]},{"code":401,"indent":1,"parameters":["... Вероятно, он пройдёт игру в нашем переводе. "]},{"code":401,"indent":1,"parameters":["Уже представляю, как ему станет неприятно."]},{"code":230,"indent":1,"parameters":[60]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["kirrel50:"]},{"code":401,"indent":1,"parameters":["Да, вы можете сказать, что я поступаю плохо."]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["kirrel50: "]},{"code":401,"indent":1,"parameters":["Однако... Знаете, с БТР у меня связан большой"]},{"code":401,"indent":1,"parameters":["отрезок моей жизни. Эти два года... "]},{"code":401,"indent":1,"parameters":["Были наполнены в основном плохими воспоминаниями."]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["kirrel50:"]},{"code":401,"indent":1,"parameters":["Ну, не буду вас мучать своими терзаниями."]},{"code":401,"indent":1,"parameters":["Хочу сказать вам огромное спасибо за то,"]},{"code":401,"indent":1,"parameters":["что вы прикоснулись к 